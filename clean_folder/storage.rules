rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper Functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    // ── 1. Incident evidence ──────────────────────────────────────────
    // Evidence photos and videos are uploaded to Cloudinary, not here, and
    // their links are kept in the private incidents/{id}/confidential doc.
    // This old path stays closed so nobody can read or plant files in it.
    match /incidents/{incidentId}/{fileName} {
      allow read, write: if false;
    }

    // ── 2. Citizen Profile Avatars ────────────────────────────────────
    match /avatars/{userId}/{fileName} {
      // Anyone authenticated can view profile pictures
      allow read: if isAuthenticated();

      // Users can only upload their own avatar image, strictly capped at 5MB
      allow write: if isAuthenticated() && 
                    request.auth.uid == userId && 
                    isImage() && 
                    request.resource.size < 5 * 1024 * 1024;
    }
  }
}
