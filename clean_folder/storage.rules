rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper Functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    // ── 1. Incident Evidence Media (Photos & Low-Latency Videos) ─────
    match /incidents/{incidentId}/{fileName} {
      // Authenticated citizens and desk dispatchers can view attached incident media
      allow read: if isAuthenticated();

      // Citizens can upload evidence photos up to 10MB, or evidence videos up to 25MB
      allow write: if isAuthenticated() &&
                    ((isImage() && request.resource.size < 10 * 1024 * 1024) ||
                     (isVideo() && request.resource.size < 25 * 1024 * 1024));
    }

    // ── 2. Citizen Profile Avatars ────────────────────────────────────
    match /avatars/{userId}/{fileName} {
      // Anyone authenticated can view profile pictures
      allow read: if isAuthenticated();

      // Users can only upload their own avatar image, strictly capped at 5MB
      allow write: if isAuthenticated() && 
                    request.auth.uid == userId && 
                    isImage() && 
                    request.resource.size < 5 * 1024 * 1024;
    }
  }
}
