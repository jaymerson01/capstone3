rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Admin = the user's own /users document says role == 'admin'.
    // Residents can never set this themselves (see the users rules below).
    function isAdmin() {
      return isAuthenticated() &&
        exists(userDoc()) &&
        get(userDoc()).data.get('role', 'resident') == 'admin';
    }

    // Super admin = an admin whose profile has isSuperAdmin: true. Only a
    // super admin can make or unmake admins and reset two-step verification.
    function isSuperAdmin() {
      return isAdmin() && get(userDoc()).data.get('isSuperAdmin', false) == true;
    }

    // Responder = an active account with role 'responder' and a department.
    function isResponder() {
      return isActiveUser() && get(userDoc()).data.get('role', '') == 'responder';
    }

    function myDepartment() {
      return get(userDoc()).data.get('department', '');
    }

    // Default departments by incident type (keep in step with Department.forCategory).
    function routedDepartments(category) {
      let c = category.lower();
      return c.matches('.*fire.*') ? ['bfp', 'tanod']
        : c.matches('.*medical.*') ? ['health']
        : c.matches('.*(flood|calamity|road accident).*') ? ['health', 'tanod']
        : c.matches('.*(theft|robbery|violence|fight|suspicious|missing).*') ? ['pnp', 'tanod']
        : ['tanod'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Signed-in user whose account has not been suspended by an admin.
    function isActiveUser() {
      return isAuthenticated() &&
        exists(userDoc()) &&
        get(userDoc()).data.get('isActive', true) != false;
    }

    // Resident whose ID the barangay has checked (see ResidentAccess in the app).
    function isVerifiedResident() {
      return isActiveUser() && get(userDoc()).data.get('isVerified', false) == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Fields only an admin may change on a user profile.
    function protectedUserFields() {
      return ['role', 'status', 'isActive', 'isVerified', 'isSuperAdmin', 'department'];
    }

    // Contact details that must never sit in the public incident document.
    function privateIncidentFields() {
      return ['reporterName', 'reporterEmail', 'victimName', 'victimPhone'];
    }

    // ── 1. Users ──────────────────────────────────────────────────────
    match /users/{userId} {
      // Only the owner and admins can see a profile (phone, address, tokens).
      allow read: if isOwner(userId) || isAdmin();

      // Self-registration: always a normal, active, not-yet-verified resident.
      // An admin verifies residency later in User Management.
      allow create: if isOwner(userId) &&
        request.resource.data.get('role', 'resident') == 'resident' &&
        request.resource.data.get('isActive', true) == true &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('isSuperAdmin', false) == false;

      // Owners edit their own details but never role / suspension / verification.
      // Admins moderate accounts; only a super admin changes who is an admin.
      allow update: if (isAdmin() && !changedKeys().hasAny(['role', 'isSuperAdmin'])) ||
        isSuperAdmin() ||
        (isOwner(userId) && !changedKeys().hasAny(protectedUserFields()));

      // Right to erasure (RA 10173): owners may delete their own profile.
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── 1b. Admin two-step verification keys ──────────────────────────
    // Each admin's authenticator key is readable only by that admin. It is
    // set once; a super admin deletes it if the admin loses their phone.
    match /admin_mfa/{userId} {
      allow read: if isOwner(userId) && isAdmin();
      allow create: if isOwner(userId) && isAdmin() &&
        request.resource.data.keys().hasOnly(['secret', 'email', 'enabledAt']) &&
        request.resource.data.secret is string;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── 1c. Residency verification requests ───────────────────────────
    // A resident's valid-ID photo for review: readable by them and admins
    // only. Admins approve (the request is deleted) or reject (the photo goes).
    match /verification_requests/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) &&
        get(userDoc()).data.get('role', 'resident') == 'resident' &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'idType', 'image', 'status', 'submittedAt']) &&
        request.resource.data.uid == userId &&
        request.resource.data.idType in ['government_id', 'valid_id'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.image is string &&
        request.resource.data.image.size() < 900000 &&
        request.resource.data.submittedAt == request.time;
      allow update, delete: if isAdmin();
    }

    // ── 2. Incidents (public part) ────────────────────────────────────
    match /incidents/{incidentId} {
      // Community map / feed. Contains NO names, emails or phone numbers.
      // Verified residents see everyone's reports; others only their own.
      // (A report that does not exist yet reads as empty, so the app can
      // check before uploading one filed offline.)
      allow read: if isAdmin() || isResponder() || isVerifiedResident() ||
        (isAuthenticated() && (resource == null || resource.data.reporterId == request.auth.uid));

      // New report: active resident, filed as themselves, clean starting state,
      // no private contact fields in the public document.
      allow create: if isActiveUser() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        request.resource.data.get('upvoteCount', 0) == 0 &&
        request.resource.data.get('validatedUserIds', []).size() == 0 &&
        request.resource.data.get('dispatcherNotes', null) == null &&
        request.resource.data.get('rating', null) == null &&
        request.resource.data.get('assignedResponderId', null) == null &&
        request.resource.data.get('departments', null) == null &&
        request.resource.data.get('estimatedResponseTime', null) == null &&
        // Anonymous and on-behalf reports are for verified residents.
        ((request.resource.data.get('isAnonymous', false) != true &&
          request.resource.data.get('isReportingOnBehalf', false) != true) || isVerifiedResident()) &&
        // The verified mark, when sent, must be true.
        (request.resource.data.get('reporterVerified', null) == null ||
         request.resource.data.reporterVerified == isVerifiedResident()) &&
        (request.resource.data.get('urgencyStatus', null) == null ||
         request.resource.data.urgencyStatus in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL']) &&
        !request.resource.data.keys().hasAny(privateIncidentFields());

      // 1. Admins: status, ETA, dispatcher notes, archive.
      // 2. "Me Too" upvote: exactly +1, only your own uid added, once, not on your own report.
      // 3. Reporter may fix the text/location of their own report while it is still pending.
      // 4. The reporter rates the response to their resolved report, once.
      // 5. Responders: accept an unassigned report of their department, then
      //    report progress on the ones assigned to them.
      allow update: if isAdmin() || isValidUpvote() || isOwnerPendingEdit() || isOwnerRating() ||
        isResponderAccept() || isResponderProgress();

      allow delete: if isAdmin();

      function isValidUpvote() {
        let oldIds = resource.data.get('validatedUserIds', []);
        let newIds = request.resource.data.get('validatedUserIds', []);
        return isActiveUser() &&
          changedKeys().hasOnly(['upvoteCount', 'validatedUserIds']) &&
          request.resource.data.get('upvoteCount', 0) == resource.data.get('upvoteCount', 0) + 1 &&
          !(request.auth.uid in oldIds) &&
          newIds.size() == oldIds.size() + 1 &&
          newIds.toSet().difference(oldIds.toSet()).hasOnly([request.auth.uid]) &&
          resource.data.get('reporterId', '') != request.auth.uid;
      }

      function isResponderAccept() {
        return isResponder() &&
          resource.data.get('assignedResponderId', null) == null &&
          myDepartment() in resource.data.get('departments', routedDepartments(resource.data.get('category', ''))) &&
          changedKeys().hasOnly(['assignedResponderId', 'assignedResponderName', 'assignedAt']) &&
          request.resource.data.assignedResponderId == request.auth.uid;
      }

      function isResponderProgress() {
        return isResponder() &&
          resource.data.get('assignedResponderId', '') == request.auth.uid &&
          request.resource.data.get('assignedResponderId', '') == request.auth.uid &&
          changedKeys().hasOnly(['status', 'responderStatus', 'responderStatusAt', 'responderNotes',
                                 'responderPhotoUrl', 'inProgressAt', 'resolvedAt', 'respondedAt', 'updatedAt']) &&
          request.resource.data.get('status', 'pending') in ['pending', 'in_progress', 'resolved'];
      }

      function isOwnerRating() {
        let data = request.resource.data;
        return isActiveUser() &&
          resource.data.get('reporterId', '') == request.auth.uid &&
          resource.data.get('status', '') == 'resolved' &&
          resource.data.get('rating', null) == null &&
          changedKeys().hasOnly(['rating', 'ratingComment', 'ratedAt']) &&
          data.rating is int && data.rating >= 1 && data.rating <= 5 &&
          (!('ratingComment' in data) ||
            (data.ratingComment is string && data.ratingComment.size() <= 500)) &&
          data.ratedAt == request.time;
      }

      function isOwnerPendingEdit() {
        return isActiveUser() &&
          resource.data.get('reporterId', '') == request.auth.uid &&
          resource.data.get('status', '') == 'pending' &&
          changedKeys().hasOnly(['description', 'photoUrl', 'videoUrl', 'resolvedAddress',
                                 'areaSector', 'latitude', 'longitude', 'isAnonymous']) &&
          (request.resource.data.get('isAnonymous', false) != true || isVerifiedResident());
      }

      // ── 2a. The responder's live position while on the way ──────────
      // Readable by the reporter, admins and the assigned responder only.
      match /tracking/{docId} {
        function report() {
          return get(/databases/$(database)/documents/incidents/$(incidentId)).data;
        }
        allow read: if isAdmin() ||
          (isAuthenticated() && report().reporterId == request.auth.uid) ||
          (isResponder() && report().get('assignedResponderId', '') == request.auth.uid);
        allow write: if isResponder() && report().get('assignedResponderId', '') == request.auth.uid;
      }

      // ── 2b. Incident contact details (private) ──────────────────────
      // Reporter name/email and victim name/phone live here, readable only
      // by the person who filed the report and by admins.
      match /confidential/{docId} {
        allow read: if isAdmin() ||
          (isAuthenticated() && resource.data.reporterId == request.auth.uid) ||
          (isResponder() &&
            get(/databases/$(database)/documents/incidents/$(incidentId)).data.get('assignedResponderId', '') == request.auth.uid);
        allow create: if isAdmin() || (isActiveUser() &&
          request.resource.data.reporterId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/incidents/$(incidentId)).data.reporterId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // Collection-group reads of live responder positions (admin dispatch map).
    match /{path=**}/tracking/{docId} {
      allow read: if isAdmin();
    }

    // Collection-group reads of contact details (admin desk, "My Reports").
    match /{path=**}/confidential/{docId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
    }

    // ── 3. Audit Logs (immutable, admin only) ─────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── 4. Emergency Broadcasts ───────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /emergency_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 5. Notifications ──────────────────────────────────────────────
    // recipientId is a user uid, 'admin', or a shared audience
    // ('all_residents' / 'broadcast'). Shared notifications track read and
    // dismissed state per person in readBy / hiddenFor.
    match /notifications/{notifId} {
      function isShared(rid) {
        return rid in ['all_residents', 'broadcast'];
      }

      allow read: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.recipientId == request.auth.uid || isShared(resource.data.recipientId)));

      // Residents may only create the two notifications the app sends for them:
      //  - 'new_report' to the admin desk, about their own report
      //  - 'upvote' to the author of a report they just corroborated
      allow create: if isAdmin() || (isActiveUser() && isResidentNotification()) ||
        (isResponder() && isResponderNotification());

      // A responder tells the reporter and the admin desk about their own report.
      function isResponderNotification() {
        let data = request.resource.data;
        let incidentPath = /databases/$(database)/documents/incidents/$(data.get('incidentId', 'none'));
        return data.get('isRead', false) == false &&
          exists(incidentPath) &&
          get(incidentPath).data.get('assignedResponderId', '') == request.auth.uid &&
          ((data.recipientId == 'admin' && data.type == 'responder_update') ||
           (data.recipientId == get(incidentPath).data.reporterId && data.type == 'status_change'));
      }

      function isResidentNotification() {
        let data = request.resource.data;
        let incidentPath = /databases/$(database)/documents/incidents/$(data.get('incidentId', 'none'));
        return data.get('isRead', false) == false &&
          exists(incidentPath) &&
          (
            (data.recipientId == 'admin' && data.type == 'new_report' &&
              get(incidentPath).data.reporterId == request.auth.uid) ||
            (data.type == 'upvote' &&
              data.recipientId == get(incidentPath).data.reporterId &&
              request.auth.uid in get(incidentPath).data.get('validatedUserIds', []))
          );
      }

      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.recipientId == request.auth.uid &&
          changedKeys().hasOnly(['isRead'])) ||
        (isAuthenticated() && isShared(resource.data.recipientId) &&
          changedKeys().hasOnly(['readBy', 'hiddenFor']) &&
          request.resource.data.get('readBy', []).toSet()
            .difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.uid]) &&
          request.resource.data.get('hiddenFor', []).toSet()
            .difference(resource.data.get('hiddenFor', []).toSet()).hasOnly([request.auth.uid]));

      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.recipientId == request.auth.uid);
    }

    // ── 6. Resident feedback & bug reports ────────────────────────────
    match /app_feedback/{feedbackId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ── 7. Incident categories & barangay areas (admin managed) ───────
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── 8. Barangay responders (tanod, BPAT…) admins assign to reports ──
    match /responders/{responderId} {
      allow read, write: if isAdmin();
    }
  }
}
